{
  "name": "kirk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p convex",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "e2e": "pnpm --filter @kirk/e2e e2e",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.96",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "convex": "^1.46.0",
    "convex-test": "^0.0.60",
    "fractional-indexing": "^4.0.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
